#!/bin/sh
# Inspect the exact outgoing Git objects, including the delivery ZIP.
set -eu
repo=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
 case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
 if [ "$remote_oid" != 0000000000000000000000000000000000000000 ] && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
  python3 "$repo/tools/check_privacy.py" --repo "$repo" --ref "$local_oid" --since "$remote_oid"
 else
  python3 "$repo/tools/check_privacy.py" --repo "$repo" --ref "$local_oid" --all-history
 fi
done
